{
    "name": "micschk/silverstripe-excludechildren",
    "description": "Extension to hide pages from the SiteTree",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "excludechildren",
        "sitetree"
    ],
    "authors": [
        {
            "name": "micschk"
        }
    ],
    "require": {
        "php": "^8.5",
        "silverstripe/cms": "^6.0",
        "silverstripe/framework": "^6.0",
        "silverstripe/vendor-plugin": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "silverstripe/recipe-cms": "^6.0"
    },
    "extra": {
        "installer-name": "excludechildren",
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "autoload": {
        "psr-4": {
            "micschk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "micschk\\Tests\\": "tests/"
        },
        "classmap": [
            "app/src/Page.php",
            "app/src/PageController.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true
        }
    }
}
