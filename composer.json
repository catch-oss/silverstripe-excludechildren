{
    "name": "micschk/silverstripe-excludechildren",
    "description": "Extension to hide pages from the SiteTree",
    "type": "silverstripe-vendormodule",
    "keywords": ["silverstripe", "excludechildren", "sitetree"],
    "authors": [
        {
            "name": "micschk"
        }
    ],
    "require": {
        "php": "^8.5",
        "silverstripe/cms": "^6.0",
        "silverstripe/framework": "^6.0",
        "silverstripe/vendor-plugin": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "extra": {
        "installer-name": "excludechildren"
    },
    "autoload": {
        "psr-4": {
            "micschk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "micschk\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    }
}
